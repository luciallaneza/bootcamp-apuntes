<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="sistema_biblioteca.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2733"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="autores" custom_title="0" dock_id="1" table="4,7:mainautores"/><dock_state state="000000ff00000000fd00000001000000020000041b000002b6fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000041b0000011800ffffff0000041b0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="autores" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="195"/><column index="3" value="79"/><column index="4" value="107"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="1_crear_tablas">-- Autores
CREATE TABLE autores (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    nacionalidad TEXT,
    fecha_nacimiento DATE
);

-- Editoriales
CREATE TABLE editoriales (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL UNIQUE,
    pais TEXT
);

-- Libros
CREATE TABLE libros (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    isbn TEXT UNIQUE NOT NULL,
    titulo TEXT NOT NULL,
    autor_id INTEGER NOT NULL,
    editorial_id INTEGER,
    año_publicacion INTEGER CHECK (año_publicacion &gt; 1000 AND año_publicacion &lt;= 2100),
    paginas INTEGER CHECK (paginas &gt; 0),
    disponible BOOLEAN DEFAULT 1,
    FOREIGN KEY (autor_id) REFERENCES autores(id),
    FOREIGN KEY (editorial_id) REFERENCES editoriales(id)
);

-- Usuarios
CREATE TABLE usuarios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    telefono TEXT,
    fecha_registro DATE DEFAULT CURRENT_DATE,
    activo BOOLEAN DEFAULT 1
);

-- Préstamos
CREATE TABLE prestamos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    usuario_id INTEGER NOT NULL,
    libro_id INTEGER NOT NULL,
    fecha_prestamo DATE DEFAULT CURRENT_DATE,
    fecha_devolucion_prevista DATE,
    fecha_devolucion_real DATE,
    dias_prestamo INTEGER NOT NULL CHECK (dias_prestamo &gt; 0),
    devuelto BOOLEAN DEFAULT 0,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id),
    FOREIGN KEY (libro_id) REFERENCES libros(id)
);

</sql><sql name="indices_acelerar_busquedas">-- Índices para acelerar búsquedas
CREATE INDEX idx_libros_autor ON libros(autor_id);
CREATE INDEX idx_libros_isbn ON libros(isbn);
CREATE INDEX idx_prestamos_usuario ON prestamos(usuario_id);
CREATE INDEX idx_prestamos_libro ON prestamos(libro_id);</sql><sql name="2_insertar_datos">-- Autores
