</sql><sql name="3_consultas_basicas">-- 3.1 Listar todos los libros con autor y editorial
SELECT libros.titulo, a.nombre AS autor, e.nombre AS editorial
FROM libros 
JOIN autores a ON libros.autor_id = a.id
JOIN editoriales e ON libros.editorial_id = e.id
GROUP BY libros.titulo, a.nombre, e.nombre;

-- 3.2 Usuarios con préstamos activos
SELECT DISTINCT u.nombre AS usuario, u.email, u.telefono, p.fecha_devolucion_prevista
FROM usuarios u
JOIN prestamos p ON u.id = p.usuario_id
WHERE p.devuelto = 0;

-- 3.3 Libros nunca prestados
SELECT l.id, l.isbn, l.titulo
FROM libros l
JOIN prestamos p ON l.id = p.libro_id
WHERE l.id NOT IN (SELECT libro_id FROM prestamos); 



</sql><sql name="4_agregaciones">-- 4..1 Total de préstamos por usuario
SELECT u.id, u.nombre AS usuario, COUNT(p.id) AS total_prestamos
FROM usuarios u
JOIN prestamos p ON u.id = p.usuario_id
GROUP BY usuario
ORDER BY total_prestamos DESC;
--Solución según apuntes
SELECT 
    u.nombre,
    COUNT(p.id) AS total_prestamos,
    SUM(CASE WHEN p.devuelto = 0 THEN 1 ELSE 0 END) AS prestamos_activos
FROM usuarios u
LEFT JOIN prestamos p ON u.id = p.usuario_id
GROUP BY u.id, u.nombre
ORDER BY total_prestamos DESC;

-- 4.2 Libros más prestados
SELECT l.titulo, a.nombre AS autor, COUNT(p.id) AS total_prestamos
FROM libros l
JOIN autores a ON l.autor_id = a.id
JOIN prestamos p ON l.id = p.libro_id
GROUP BY l.titulo
ORDER BY total_prestamos DESC
LIMIT 5;

-- Promedio de días de préstamo por libro
SELECT l.titulo, ROUND(AVG(p.dias_prestamo),2) AS promedio_dias_prestamo
FROM libros l
JOIN prestamos p ON l.id = p.libro_id
GROUP BY l.titulo
ORDER BY promedio_dias_prestamo DESC
LIMIT 5;
--Solución según apuntes
SELECT 
    l.titulo,
    COUNT(p.id) AS prestamos,
    ROUND(AVG(p.dias_prestamo), 1) AS promedio_dias
FROM libros l
INNER JOIN prestamos p ON l.id = p.libro_id
GROUP BY l.id, l.titulo
HAVING COUNT(p.id) &gt; 0
ORDER BY promedio_dias DESC;</sql><sql name="5_consultas_avanzadas">-- Préstamos con retraso (fecha real &gt; prevista)
SELECT l.titulo, p.dias_prestamo, p.fecha_devolucion_prevista, p. fecha_devolucion_real
FROM libros l
JOIN prestamos p ON l.id = p.libro_id
WHERE p.fecha_devolucion_real &gt; p.fecha_devolucion_prevista
GROUP BY l.titulo
ORDER BY p.dias_prestamo DESC;
-- Solución según apuntes
SELECT 
    u.nombre AS usuario,
    l.titulo AS libro,
    p.fecha_prestamo,
    p.fecha_devolucion_prevista,
    p.fecha_devolucion_real,
    JULIANDAY(p.fecha_devolucion_real) - JULIANDAY(p.fecha_devolucion_prevista) AS dias_retraso
FROM prestamos p
INNER JOIN usuarios u ON p.usuario_id = u.id
INNER JOIN libros l ON p.libro_id = l.id
WHERE p.devuelto = 1
  AND p.fecha_devolucion_real &gt; p.fecha_devolucion_prevista;
  
-- Autores con más préstamos
SELECT a.nombre AS autor, l.titulo, COUNT(p.id) AS total_prestamos
FROM autores a
JOIN libros l ON a.id = l.autor_id
JOIN prestamos p ON l.id = p.libro_id
GROUP BY autor 
ORDER BY total_prestamos DESC; 

-- Usuarios con préstamos superiores al promedio
SELECT u.nombre AS usuario, COUNT(p.id)
FROM usuarios u
JOIN prestamos p ON u.id = p.usuario_id
GROUP BY usuario
HAVING COUNT(p.id) &gt; (
	SELECT AVG(cuenta)
	FROM (
		SELECT COUNT (*) AS cuenta
		FROM prestamos p
		GROUP BY usuario_id
	)
);

-- Libros prestados actualmente con información del usuario
SELECT l.titulo, u.nombre AS usuario, u.email, u.telefono
FROM libros l
JOIN prestamos p ON l.id = p.libro_id
JOIN usuarios u ON p.usuario_id = u.id
WHERE p.devuelto = 0
GROUP BY l.titulo, usuario, u.email, u.telefono;
-- Solución según apuntes
SELECT 
    l.titulo AS libro,
    a.nombre AS autor,
    u.nombre AS usuario,
    u.email,
    p.fecha_prestamo,
    DATE(p.fecha_prestamo, '+' || p.dias_prestamo || ' days') AS fecha_devolucion_prevista,
    p.dias_prestamo
FROM prestamos p
INNER JOIN usuarios u ON p.usuario_id = u.id
INNER JOIN libros l ON p.libro_id = l.id
INNER JOIN autores a ON l.autor_id = a.id
WHERE p.devuelto = 0
ORDER BY p.fecha_prestamo;


</sql><sql name="6_analisis_estadistico">-- Estadísticas generales
SELECT 
    (SELECT COUNT(*) FROM libros) AS total_libros,
    (SELECT COUNT(*) FROM usuarios) AS total_usuarios,
    (SELECT COUNT(*) FROM prestamos) AS total_prestamos,
    (SELECT COUNT(*) FROM prestamos WHERE devuelto = 0) AS prestamos_activos,
    (SELECT ROUND(AVG(dias_prestamo), 1) FROM prestamos) AS promedio_dias_prestamo;
	
-- Distribución de préstamos por mes
SELECT 
    STRFTIME('%Y-%m', fecha_prestamo) AS mes,
    COUNT(*) AS total_prestamos
FROM prestamos
GROUP BY mes
ORDER BY mes DESC;

-- Tasa de devolución a tiempo
SELECT 
    COUNT(*) AS total_devueltos,
    SUM(CASE 
        WHEN fecha_devolucion_real &lt;= fecha_devolucion_prevista THEN 1 
        ELSE 0 
    END) AS devueltos_a_tiempo,
    ROUND(
        SUM(CASE 
            WHEN fecha_devolucion_real &lt;= fecha_devolucion_prevista THEN 1 
            ELSE 0 
        END) * 100.0 / COUNT(*), 
        2
    ) AS porcentaje_a_tiempo
FROM prestamos
WHERE devuelto = 1;

-- Libros devueltos a tiempo 
SELECT
	l.titulo, p.id,
    COUNT (*) AS total_devueltos,
    SUM(CASE 
        WHEN p.fecha_devolucion_real &lt;= p.fecha_devolucion_prevista THEN 1 
        ELSE 0 
    END) AS devueltos_a_tiempo,
    ROUND(
        SUM(CASE 
            WHEN p.fecha_devolucion_real &lt;= p.fecha_devolucion_prevista THEN 1 
            ELSE 0 
        END) * 100.0 / COUNT(*), 
        2
    ) AS porcentaje_a_tiempo
FROM prestamos p
JOIN libros l ON l.id = p.libro_id
WHERE devuelto = 1
GROUP BY p.id;</sql><sql name="7_actualizaciones_y_transacciones">-- Registrar devolución de un libro
UPDATE prestamos
SET 
    devuelto = 1,
    fecha_devolucion_real = CURRENT_DATE
WHERE id = 4;

-- Actualizar disponibilidad del libro
UPDATE libros
SET disponible = 1
WHERE id = (SELECT libro_id FROM prestamos WHERE id = 4);


-- Nuevo préstamo (transacción completa)
	-- Con esto comprobamos si este id está disponible
SELECT disponible FROM libros WHERE id = 1;

	-- Ahora comezamos la transacción del nuevo préstamo
BEGIN TRANSACTION;
	-- Insertar préstamo
INSERT INTO prestamos (usuario_id, libro_id, fecha_prestamo, dias_prestamo, fecha_devolucion_prevista, devuelto)
VALUES (
    2,  -- Usuario Carlos
    1,  -- Libro Cien años de soledad
	DATE('now'),
    15,
    DATE('now', '+15 days'),
	0
);

	-- Marcar libro como no disponible
UPDATE libros
SET disponible = 0
WHERE id = 1;

COMMIT;

-- Le di a ejecutar dos veces y creé dos p.id que triplican esta transacción, voy a eliminarlos
--DELETE FROM prestamos WHERE id IN (10, 11);

-- Otro ejemplo de insertar préstamo
	-- Con esto comprobamos si este id está disponible
SELECT disponible FROM libros WHERE id = 3;
	-- Ahora comezamos la transacción del nuevo préstamo
BEGIN TRANSACTION;
	-- Insertar préstamo
INSERT INTO prestamos (usuario_id, libro_id, fecha_prestamo, dias_prestamo, fecha_devolucion_prevista, devuelto)
VALUES (
    5,  -- Usuario Laura Sánchez
    3,  -- Libro Tokio Blues
	DATE('now', '-2 days'), --antesdeayer
    15,
    DATE('now', '-2 days', '+15 days'),
	0
);

-- Marcar libro como no disponible
UPDATE libros
SET disponible = 0
WHERE id = 3;

COMMIT;

-- Al haber triplicado la transacción de Carlos en la líneas 10 y 11, esta última transacción de Laura pasó a tener id 12. Voy a cambiarlo para que quede correlativo. IMPORTANTE: en entorn real NO hacer esto ya que puede afectar a otras tablas.
--UPDATE prestamos
--SET id = 10
--WHERE id = 12;

-- DELETE FROM prestamos WHERE id IN (13, 14);

-- Hacer una devolución: voy a devolver el préstamo de Laura
	-- Primero veo qué libro tenía
	SELECT libro_id from prestamos WHERE id = 10;
	-- Ahora inicio la devolución
BEGIN TRANSACTION;
	-- Modificar préstamo
UPDATE prestamos 
SET 
	fecha_devolucion_real = DATE('now'),
	devuelto = 1
WHERE id = 10;

-- Marcar libro como disponible
UPDATE libros
SET disponible = 1
WHERE id = 3;

COMMIT;</sql><sql name="8_vistas_utiles">-- Vista de préstamos activos con información completa
CREATE VIEW prestamos_activos AS
SELECT 
    p.id,
    u.nombre AS usuario,
    u.email,
    l.titulo AS libro,
    a.nombre AS autor,
    p.fecha_prestamo,
    DATE(p.fecha_prestamo, '+' || p.dias_prestamo || ' days') AS fecha_devolucion_prevista,
    JULIANDAY('now') - JULIANDAY(p.fecha_prestamo) AS dias_transcurridos
FROM prestamos p
INNER JOIN usuarios u ON p.usuario_id = u.id
INNER JOIN libros l ON p.libro_id = l.id
INNER JOIN autores a ON l.autor_id = a.id
WHERE p.devuelto = 0;

-- Usar la vista
SELECT * FROM prestamos_activos;

-- Vista de estadísticas por usuario
CREATE VIEW estadisticas_usuarios AS
SELECT 
    u.id,
    u.nombre,
    COUNT(p.id) AS total_prestamos,
    SUM(CASE WHEN p.devuelto = 0 THEN 1 ELSE 0 END) AS prestamos_activos,
    AVG(p.dias_prestamo) AS promedio_dias
FROM usuarios u
LEFT JOIN prestamos p ON u.id = p.usuario_id
GROUP BY u.id, u.nombre;

-- Usar la vista
SELECT * FROM estadisticas_usuarios ORDER BY total_prestamos DESC;</sql><sql name="9.1_desafio_multas_morosos">-- Sistema de multas
--Creo tabla de multas
CREATE TABLE multas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    prestamo_id INTEGER NOT NULL,
    importe REAL NOT NULL CHECK (importe &gt;= 0),
    pagada BOOLEAN DEFAULT 0,
    FOREIGN KEY (prestamo_id) REFERENCES prestamos(id)
);

--Rellenamos fechas NULL
UPDATE prestamos 
SET fecha_devolucion_prevista = DATE(fecha_prestamo, '+' || dias_prestamo || ' days')
WHERE fecha_devolucion_prevista IS NULL;

-- Inserta multas calculando 0,05€ por día de retraso
INSERT INTO multas (prestamo_id, importe)
SELECT 
    id, 
    (julianday(fecha_devolucion_real) - julianday(fecha_devolucion_prevista)) * 0.50
FROM prestamos
WHERE devuelto = 1 
  AND fecha_devolucion_real &gt; fecha_devolucion_prevista;
  
 -- Si no se ha devuelto todavía
 SELECT 
    p.id AS prestamo_no_devuelto,
	u.nombre,
    (julianday('now') - julianday(p.fecha_devolucion_prevista)) * 0.50 AS multa_acumulada_hoy
FROM prestamos p
JOIN usuarios u ON p.usuario_id = u.id
WHERE p.devuelto = 0 
  AND DATE('now') &gt; p.fecha_devolucion_prevista;
  
  -- Informe de morosos
  SELECT 
    u.nombre AS usuario, 
    l.titulo AS libro, 
    m.importe || ' €' AS deuda,
    CASE WHEN m.pagada = 1 THEN 'SÍ' ELSE 'NO' END AS pagada
FROM multas m
JOIN prestamos p ON m.prestamo_id = p.id
JOIN usuarios u ON p.usuario_id = u.id
JOIN libros l ON p.libro_id = l.id;

-- DELETE FROM multas WHERE id IN (2, 3);
  </sql><sql name="9.1_desafio_multas_actualizado">-- Borrar tabla anterior de maultas y añadir más campos
DROP TABLE IF EXISTS multas;

--Crear tabla multas más completa
CREATE TABLE multas (
id INTEGER PRIMARY KEY AUTOINCREMENT,
    prestamo_id INTEGER NOT NULL,
    usuario_id INTEGER NOT NULL, -- Acceso directo al usuario sin pasar por prestamos
    dias_retraso INTEGER DEFAULT 0,
    importe REAL NOT NULL CHECK (importe &gt;= 0),
    pagada BOOLEAN DEFAULT 0,
    fecha_ultima_revision DATE, -- Cuándo se calculó este importe
    FOREIGN KEY (prestamo_id) REFERENCES prestamos(id),
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id)
);

--Alimentamos tabla
INSERT INTO multas (prestamo_id, usuario_id, dias_retraso, importe, fecha_ultima_revision)
SELECT 
    p.id, 
    p.usuario_id,
    CAST(julianday('now') - julianday(p.fecha_devolucion_prevista) AS INTEGER) AS dias, --CAST traduce datos, aquí pasa de decimales a enteros
    ROUND(julianday('now') - julianday(p.fecha_devolucion_prevista), 2) * 0.50 AS total_multa,
    DATE('now')
FROM prestamos p
WHERE p.devuelto = 0 
  AND DATE('now') &gt; p.fecha_devolucion_prevista;
  
-- Información de usuarios con demoras
SELECT 
    u.nombre, 
    l.titulo, 
    p.fecha_devolucion_prevista,
    CAST(julianday('now') - julianday(p.fecha_devolucion_prevista) AS INTEGER) || ' días' AS retraso_acumulado,
    ROUND((julianday('now') - julianday(p.fecha_devolucion_prevista)) * 0.50, 2) || ' €' AS multa_actual
FROM prestamos p
JOIN usuarios u ON p.usuario_id = u.id
JOIN libros l ON p.libro_id = l.id
WHERE p.devuelto = 0 AND DATE('now') &gt; p.fecha_devolucion_prevista;
</sql><sql name="9.3 Historial_completo_de-usuario">SELECT 
    u.nombre AS Usuario,
    COUNT(p.id) AS total_prestamos,
    -- Sumamos los días de todos sus préstamos (usando julianday para precisión)
    CAST(SUM(
        CASE 
            WHEN p.devuelto = 1 THEN julianday(p.fecha_devolucion_real) - julianday(p.fecha_prestamo)
            ELSE julianday('now') - julianday(p.fecha_prestamo) 
        END
    ) AS INTEGER) AS total_dias_con_libros,
    -- Contamos cuántas veces se ha retrasado
    SUM(CASE WHEN p.fecha_devolucion_real &gt; p.fecha_devolucion_prevista THEN 1 ELSE 0 END) AS numero_de_retrasos,
    -- Sumamos el importe total de sus multas (usamos COALESCE para que los que no tienen multas salgan con 0.00 y no NULL)
    ROUND(SUM(COALESCE(m.importe, 0)), 2) || ' €' AS total_multas_acumuladas
FROM usuarios u
JOIN prestamos p ON u.id = p.usuario_id
LEFT JOIN multas m ON p.id = m.prestamo_id -- LEFT JOIN para no borrar a los usuarios &quot;buenos&quot;
GROUP BY u.id, u.nombre
ORDER BY total_multas_acumuladas DESC;

</sql><sql name="9.4_recomendaciones">-- Encuentra libros del mismo autor que los que ha leído un usuario pero que aún no ha tomado prestados
SELECT
	u.nombre AS usuario,
	l.titulo,
	a.id,
	a.nombre AS autor
FROM usuarios u
JOIN prestamos p ON u.id = p.usuario_id
JOIN libros l ON p.libro_id = l.id
JOIN autores a ON l.autor_id = a.id
ORDER BY usuario;


-- Prueba con usuario 2
SELECT l.id, l.titulo
FROM libros l
WHERE l.autor_id IN (
SELECT DISTINCT l.autor_id
FROM prestamos p
JOIN libros l ON p.libro_id = l.id
WHERE p.usuario_id = 2 
)
AND l.id NOT IN (
	SELECT p.libro_id
	FROM prestamos p 
	WHERE p.usuario_id = 2
);

-- Prueba con todos los usuarios
SELECT 
    u.nombre AS usuario,
    l.titulo AS libro_recomendado,
    a.nombre AS autor
FROM usuarios u
-- Unimos con libros y autores para mostrar información legible
JOIN libros l ON l.autor_id = a.id
JOIN autores a ON l.autor_id = a.id
WHERE l.autor_id IN (
    -- Subconsulta A: Autores que ESTE usuario específico (u.id) ya ha leído
    SELECT DISTINCT l2.autor_id
    FROM prestamos p2
    JOIN libros l2 ON p2.libro_id = l2.id
    WHERE p2.usuario_id = u.id
)
AND l.id NOT IN (
    -- Subconsulta B: Libros que ESTE usuario específico (u.id) ya ha leído
    SELECT p3.libro_id 
    FROM prestamos p3
    WHERE p3.usuario_id = u.id
)
ORDER BY u.nombre;
</sql><current_tab id="6"/></tab_sql></sqlb_project>
