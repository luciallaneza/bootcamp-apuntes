<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="tabla_de_prestamos.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1027"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="prestamos" custom_title="0" dock_id="1" table="4,9:mainprestamos"/><dock_state state="000000ff00000000fd00000001000000020000059b0000038efc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000059b0000011800ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="prestamos" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="54"/><column index="3" value="85"/><column index="4" value="90"/><column index="5" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- Crear tabla de préstamos con los datos de Anaïs
CREATE TABLE prestamos (
    id INTEGER PRIMARY KEY,
    usuario TEXT,
    libro TEXT,
    dias_prestamo INTEGER,
    categoria TEXT
);

INSERT INTO prestamos (usuario, libro, dias_prestamo, categoria) VALUES
('Ana', '1984', 15, 'Ficción'),
('Carlos', 'Sapiens', 22, 'Ensayo'),
('María', 'Watchmen', 18, 'Cómic'),
('Ana', 'El Quijote', 30, 'Ficción'),
('Luis', 'Batman', 12, 'Cómic'),
('Carlos', '1984', 25, 'Ficción');

-- Todos los préstamos de Ana
SELECT * FROM prestamos
WHERE usuario = &quot;Ana&quot;;

-- Préstamos de más de 20 días
SELECT * FROM prestamos
WHERE dias_prestamo &gt; 20;

-- Préstamos de ficción o cómic, ordenados por días
SELECT * FROM prestamos
WHERE categoria IN (&quot;Ficción&quot;, &quot;Cómic&quot;)
ORDER BY dias_prestamo; 

-- Los 3 préstamos más largos
SELECT * FROM prestamos
ORDER BY dias_prestamo DESC 
LIMIT 3;

-- Categorías únicas
SELECT DISTINCT categoria 
FROM prestamos;

-- Cuántos préstamos hay por categoría
SELECT categoria, COUNT(*) AS total_prestamos
FROM prestamos
GROUP BY categoria
ORDER BY total_prestamos DESC;

-- Top usuarios con más préstamos
SELECT *,
COUNT(usuario)
FROM prestamos
GROUP BY usuario
HAVING COUNT(usuario) &gt; 1;

-- Usuarios que han tenido préstamos largos (&gt; 20 días)
SELECT *
FROM prestamos
WHERE dias_prestamo &gt; 20
ORDER BY dias_prestamo DESC;

-- o de este modo
SELECT 
    usuario,
    COUNT(*) AS prestamos_largos,
    MAX(dias_prestamo) AS max_dias
FROM prestamos
WHERE dias_prestamo &gt; 20
GROUP BY usuario;

-- Análisis completo por categoría
SELECT 
    categoria,
    COUNT(*) AS total,
    MIN(dias_prestamo) AS min_dias,
    MAX(dias_prestamo) AS max_dias,
    ROUND(AVG(dias_prestamo), 1) AS promedio_dias,
    SUM(dias_prestamo) AS total_dias
FROM prestamos
GROUP BY categoria
ORDER BY total DESC;




</sql><sql name="agregaciones">-- ¿Cuántos préstamos hay en total?
SELECT COUNT(*) AS total_prestamos
FROM prestamos;

-- ¿Cuál es el promedio de días de préstamo?
SELECT AVG(dias_prestamo) FROM prestamos;

-- ¿Cuál es el promedio de días de préstamo por usuario?
SELECT usuario,
ROUND(AVG(dias_prestamo),2) AS promedio_dias_prestamo
FROM prestamos
GROUP BY usuario
ORDER BY promedio_dias_prestamo DESC;

-- ¿Cuántos préstamos ha hecho cada usuario?
SELECT usuario,
COUNT(*)
FROM prestamos
GROUP BY usuario
ORDER BY COUNT(*) DESC;

-- ¿Qué categoría tiene el mayor promedio de días?
SELECT categoria,
ROUND(AVG(dias_prestamo),2) AS promedio_dias
FROM prestamos
GROUP BY categoria
ORDER BY promedio_dias DESC
LIMIT 1;

-- Usuarios con más de 1 préstamo
SELECT usuario,
COUNT(usuario)
FROM prestamos
GROUP BY usuario
HAVING COUNT(usuario) &gt; 1;

</sql><sql name="consultas_anidadas*">-- Buscar préstamos por encima del promedio
SELECT *
FROM prestamos
WHERE dias_prestamo &gt; (SELECT ROUND(AVG(dias_prestamo),2) FROM prestamos);

-- Libro con más días de préstamo
SELECT libro,
dias_prestamo
FROM prestamos
WHERE dias_prestamo = (SELECT MAX(dias_prestamo) FROM prestamos);

-- Buscar usuarios que han hecho préstamos
SELECT usuario
FROM prestamos
WHERE usuario IN (SELECT DISTINCT usuario FROM prestamos);

-- Usuarios que NO han hecho préstamos
SELECT usuario
FROM prestamos
WHERE usuario NOT IN (SELECT usuario FROM prestamos);

</sql><current_tab id="2"/></tab_sql></sqlb_project>
